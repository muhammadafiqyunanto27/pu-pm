---
import Layout from '../../layouts/Layout.astro';
import TopicBody from '../../components/TopicBody.astro';
import Rail from '../../components/Rail.astro';
import Pager from '../../components/Pager.astro';
import { chapters, prevNext, topicBySlug, topics } from '../../data/materi';

export function getStaticPaths() {
	return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

interface Props {
	topic: (typeof topics)[number];
}

const { topic } = Astro.props;
const chapter = chapters.find((item) => item.n === topic.chapter)!;
const { prev, next, index } = prevNext(topic.slug);
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const items = topics.map((item) => ({
	n: item.n,
	short: String(item.n).padStart(2, '0'),
	label: item.title,
	href: `${base}/rangkuman/${item.slug}`,
}));

if (!topicBySlug(topic.slug)) {
	throw new Error(`Topik tidak ditemukan: ${topic.slug}`);
}
---

<Layout
	title={`${topic.title} — Rangkuman Pasar Uang & Modal`}
	description={`${topic.desc}. Rangkuman topik ${topic.n} dari 27, Bab ${chapter.roman} — ${chapter.title}.`}
	active="rangkuman"
	crumb={`Rangkuman · Bab ${chapter.roman} · ${chapter.title} · Topik ${index} dari ${topics.length}`}
	heading={topic.title}
	subheading={topic.desc}
	chips={[`Bab ${chapter.roman}`, `±${topic.minutes} menit baca`, topic.source, topic.kicker]}
>
	<div class="wrap topic-layout">
		<TopicBody topic={topic} />
		<Rail topic={topic} chapter={chapter} base={base} />
	</div>

	<div class="wrap" style="padding-top:0">
		<div class="next-cta">
			{next ? (
				<div>
					<p class="eyebrow" style="color:inherit;opacity:.65">Berikutnya · Topik {String(next.n).padStart(2, '0')}</p>
					<h2>{next.title}</h2>
					<p>{next.desc}</p>
				</div>
			) : (
				<div>
					<p class="eyebrow" style="color:inherit;opacity:.65">Selesai · 27 dari 27</p>
					<h2>Semua topik sudah dibaca</h2>
					<p>Uji pemahaman lewat 35 soal, atau ulang bagian yang paling sering keliru.</p>
				</div>
			)}
			{next ? (
				<a class="btn" href={`${base}/rangkuman/${next.slug}`}>Lanjut <span aria-hidden="true">→</span></a>
			) : (
				<a class="btn" href={`${base}/latihan`}>Buka latihan <span aria-hidden="true">→</span></a>
			)}
		</div>
	</div>

	<Pager items={items} current={topic.n} unit="topik" />
</Layout>
